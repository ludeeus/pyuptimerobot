#!/bin/sh

# script/lint: Run linting tools and apply formatting

set -e

cd "$(dirname "$0")/.."

echo "==> Running linting tools..."

echo "==> Running ruff format..."
uv run --dev ruff format pyuptimerobot tests

echo "==> Running ruff check..."
uv run --dev ruff check --fix pyuptimerobot tests

echo "==> Running mypy..."
uv run --dev mypy pyuptimerobot

echo "==> Linting completed!"
