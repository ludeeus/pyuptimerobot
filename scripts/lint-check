#!/bin/sh

# script/lint-check: Check linting without making changes.

set -e

cd "$(dirname "$0")/.."

echo "==> Checking linting..."

echo "==> Checking ruff format..."
uv run --dev ruff format --check pyuptimerobot tests

echo "==> Checking ruff lint..."
uv run --dev ruff check pyuptimerobot tests

echo "==> Checking mypy..."
uv run --dev mypy pyuptimerobot

echo "==> Linting check completed!"
